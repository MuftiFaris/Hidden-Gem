<Window x:Class="Assistant.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hidden Gem Overlay"
        Height="600" Width="400"
        MinHeight="300" MinWidth="300"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">

    <Border CornerRadius="16"
            Background="#E6181818"
            BorderBrush="#4D7C7C7C"
            BorderThickness="1.5"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" 
                    Background="#E61E1E1E"
                    CornerRadius="16,16,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                        <TextBlock Text="💎" FontSize="18" Margin="0,0,10,0"/>
                        <TextBlock Text="Hidden Gem" 
                                   FontWeight="SemiBold" 
                                   Foreground="#FFE5E5E5"
                                   FontSize="14"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="8,0">
                        <Button Content="📌" 
                                Width="36" Height="36"
                                Click="PinButton_Click"
                                ToolTip="Pin/Unpin"
                                Background="#33FFFFFF"
                                BorderThickness="0"
                                Foreground="#FFE5E5E5"
                                FontSize="14"
                                Margin="2"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                        CornerRadius="6"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#4DFFFFFF"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="−" 
                                Width="36" Height="36"
                                Click="MinimizeButton_Click"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#FFE5E5E5"
                                FontSize="18"
                                Margin="2"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                        CornerRadius="6"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#4DFFFFFF"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="✕" 
                                Width="36" Height="36"
                                Click="CloseButton_Click"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#FFE5E5E5"
                                FontSize="14"
                                Margin="2"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                        CornerRadius="6"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#80E74856"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content Area -->
            <Border Grid.Row="1" 
                    Background="#E6252525"
                    Margin="1.5">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Padding="16">
                    <TextBlock x:Name="ResponseText"
                               TextWrapping="Wrap"
                               FontSize="13"
                               Foreground="#FFE5E5E5"
                               LineHeight="20"/>
                </ScrollViewer>
            </Border>

            <!-- Controls -->
            <Border Grid.Row="2"
                    Background="#E61E1E1E"
                    CornerRadius="0,0,16,16"
                    Padding="16,12">
                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Center">
                    <Button Content="🎤 Voice" 
                            Width="90" Height="36"
                            Margin="4"
                            Click="VoiceButton_Click"
                            Background="#FF2D2D30"
                            Foreground="#FFE5E5E5"
                            BorderBrush="#4D7C7C7C"
                            BorderThickness="1"
                            FontSize="12"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="8"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FF3D3D40"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="📷 Screen" 
                            Width="90" Height="36"
                            Margin="4"
                            Click="ScreenButton_Click"
                            Background="#FF2D2D30"
                            Foreground="#FFE5E5E5"
                            BorderBrush="#4D7C7C7C"
                            BorderThickness="1"
                            FontSize="12"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="8"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FF3D3D40"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <StackPanel Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Opacity" 
                                   Foreground="#FF808080" 
                                   FontSize="11" 
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <Slider x:Name="OpacitySlider"
                                Width="100"
                                Minimum="0.3"
                                Maximum="1.0"
                                Value="1.0"
                                VerticalAlignment="Center"
                                ValueChanged="OpacitySlider_ValueChanged"
                                ToolTip="Window Opacity"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
