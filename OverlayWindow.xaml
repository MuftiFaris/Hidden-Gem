<Window x:Class="Assistant.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edge Overlay"
        Height="600" Width="400"
        MinHeight="300" MinWidth="300"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">

    <Border CornerRadius="12"
            Background="#F0FFFFFF"
            BorderBrush="#80000000"
            BorderThickness="1"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" 
                    Background="#FF0078D4"
                    CornerRadius="12,12,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                        <TextBlock Text="🤖" FontSize="16" Margin="0,0,8,0"/>
                        <TextBlock Text="Edge" 
                                   FontWeight="SemiBold" 
                                   Foreground="White"
                                   FontSize="13"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Content="📌" 
                                Width="30" Height="30"
                                Click="PinButton_Click"
                                ToolTip="Pin/Unpin"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="White"
                                Cursor="Hand"/>
                        <Button Content="−" 
                                Width="30" Height="30"
                                Click="MinimizeButton_Click"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="White"
                                Cursor="Hand"/>
                        <Button Content="✕" 
                                Width="30" Height="30"
                                Click="CloseButton_Click"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="White"
                                Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content Area -->
            <ScrollViewer Grid.Row="1" 
                          VerticalScrollBarVisibility="Auto"
                          Padding="12">
                <TextBlock x:Name="ResponseText"
                           TextWrapping="Wrap"
                           FontSize="13"
                           Foreground="#FF000000"/>
            </ScrollViewer>

            <!-- Controls -->
            <StackPanel Grid.Row="2" 
                        Orientation="Horizontal" 
                        Margin="12"
                        HorizontalAlignment="Center">
                <Button Content="🎤 Voice" 
                        Width="80" Height="32"
                        Margin="4"
                        Click="VoiceButton_Click"/>
                <Button Content="📷 Screen" 
                        Width="80" Height="32"
                        Margin="4"
                        Click="ScreenButton_Click"/>
                <Slider x:Name="OpacitySlider"
                        Width="100"
                        Minimum="0.3"
                        Maximum="1.0"
                        Value="1.0"
                        VerticalAlignment="Center"
                        Margin="8,0"
                        ValueChanged="OpacitySlider_ValueChanged"
                        ToolTip="Opacity"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
