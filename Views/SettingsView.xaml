<UserControl x:Class="Assistant.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource AppBackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,20,28,20">
        <StackPanel MaxWidth="680" HorizontalAlignment="Left">

            <!-- Page title -->
            <TextBlock Text="Settings" FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,4"/>
            <TextBlock Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"
                       Margin="0,0,0,24"
                       Text="Configure your Gemini API key, model parameters, and privacy options."/>

            <!-- ══════════════════════════════════════════
                 SECTION: API KEY
                 ══════════════════════════════════════════ -->
            <TextBlock Text="🔑  API KEY" Style="{StaticResource SectionHeader}"/>

            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,14">
                <StackPanel>
                    <!-- Privacy notice -->
                    <Border Background="#1A3B5C" CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
                        <TextBlock TextWrapping="Wrap" FontSize="12"
                                   Foreground="#FF79C0FF">
                            <Run FontWeight="SemiBold">🔒 Security notice: </Run>
                            <Run>Your API key is stored in </Run>
                            <Run FontWeight="SemiBold">Windows Credential Manager</Run>
                            <Run>, not in any file on disk. It is never logged or transmitted anywhere except directly to the Google Gemini API.</Run>
                        </TextBlock>
                    </Border>

                    <TextBlock Text="Enter your Gemini API key:"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="12" Margin="0,0,0,6"/>

                    <!-- PasswordBox so the key is masked -->
                    <PasswordBox x:Name="ApiKeyPasswordBox"
                                 Style="{StaticResource ModernPasswordBox}"
                                 PasswordChanged="ApiKeyPasswordBox_PasswordChanged"
                                 Margin="0,0,0,8"/>

                    <!-- Action buttons -->
                    <WrapPanel Margin="0,0,0,10" HorizontalAlignment="Left">
                        <Button Style="{StaticResource PrimaryButton}"
                                Command="{Binding SaveApiKeyCommand}"
                                Content="💾  Save Key"
                                Margin="0,0,8,0"/>
                        <Button Style="{StaticResource SecondaryButton}"
                                Command="{Binding ValidateApiKeyCommand}"
                                Content="✅  Validate"
                                Margin="0,0,8,0"/>
                        <Button Style="{StaticResource DangerButton}"
                                Command="{Binding DeleteApiKeyCommand}"
                                Content="🗑  Remove Key"/>
                    </WrapPanel>

                    <!-- Status message -->
                    <TextBlock Text="{Binding ApiKeyStatus}"
                               TextWrapping="Wrap"
                               FontSize="12" Margin="0,2,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsApiKeyStatusError}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsValidating}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="Get your free API key at ai.google.dev"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="11" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════════
                 SECTION: MODEL
                 ══════════════════════════════════════════ -->
            <TextBlock Text="🤖  MODEL &amp; GENERATION" Style="{StaticResource SectionHeader}"/>

            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,14">
                <StackPanel>

                    <!-- Model selector -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Model" VerticalAlignment="Center"
                                   Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding AvailableModels}"
                                  SelectedItem="{Binding SelectedModel}"/>
                    </Grid>

                    <!-- Temperature slider -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Temperature" VerticalAlignment="Center"
                                   Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                        <Slider Grid.Column="1" Minimum="0" Maximum="1" TickFrequency="0.05"
                                Value="{Binding Temperature}" IsSnapToTickEnabled="True"
                                VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Temperature, Converter={StaticResource TempToPercent}}"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Max tokens -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Max output tokens" VerticalAlignment="Center"
                                   Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                        <TextBox Grid.Column="1"
                                 Style="{StaticResource ModernTextBox}"
                                 Text="{Binding MaxTokens, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                    <!-- Streaming toggle -->
                    <CheckBox IsChecked="{Binding UseStreaming}"
                              Content="Enable streaming responses (shows text as it generates)"/>

                    <!-- System prompt -->
                    <TextBlock Text="System prompt" Margin="0,12,0,6"
                               Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                    <TextBox Style="{StaticResource ModernTextBox}"
                             Text="{Binding SystemPrompt, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Height="80"
                             VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════════
                 SECTION: PRIVACY
                 ══════════════════════════════════════════ -->
            <TextBlock Text="🔒  PRIVACY" Style="{StaticResource SectionHeader}"/>

            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,14">
                <StackPanel>
                    <!-- Privacy mode explanation -->
                    <Border Background="#1A2C1A" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Margin="0,0,0,4" FontSize="12"
                                       Foreground="#FF3FB950">What privacy mode does</TextBlock>
                            <TextBlock TextWrapping="Wrap" FontSize="12"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       LineHeight="20">
Calls <Run FontWeight="SemiBold">SetWindowDisplayAffinity(WDA_EXCLUDEFROMCAPTURE)</Run> on the app window.
This asks Windows to hide the window content from screen-capture APIs including:
Snipping Tool, Xbox Game Bar, Microsoft Teams screen share, and similar apps that use the
Windows Graphics Capture API (WGC).
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"
                                       Foreground="{StaticResource WarningBrush}">
⚠️  Limitations: Does NOT prevent capture by OBS (window-capture mode), hardware recorders,
Remote Desktop / TeamViewer, or GPU-level tools. Requires Windows 10 version 2004 (build 19041)+.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <CheckBox Content="Enable logging (errors and metadata only — no chat content)"
                              IsChecked="{Binding EnableLogging}" Margin="0,4"/>
                    <CheckBox IsChecked="{Binding LogConversations}" Margin="0,4">
                        <TextBlock TextWrapping="Wrap">
                            <Run>Log conversation content to disk</Run>
                            <Run Foreground="{StaticResource WarningBrush}"> (off by default — opt in consciously)</Run>
                        </TextBlock>
                    </CheckBox>
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════════
                 SECTION: WINDOW BEHAVIOUR
                 ══════════════════════════════════════════ -->
            <TextBlock Text="🖥️  WINDOW BEHAVIOUR" Style="{StaticResource SectionHeader}"/>

            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,14">
                <StackPanel>
                    <CheckBox Content="Minimise to tray on close (instead of quitting)"
                              IsChecked="{Binding MinimizeToTray}" Margin="0,4"/>
                    <CheckBox Content="Start minimised to tray"
                              IsChecked="{Binding StartMinimized}" Margin="0,4"/>
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════════
                 ACTION BUTTONS
                 ══════════════════════════════════════════ -->
            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                <Button Style="{StaticResource PrimaryButton}"
                        Command="{Binding SaveSettingsCommand}"
                        Content="💾  Save Settings"
                        Margin="0,0,10,0"/>
                <Button Style="{StaticResource SecondaryButton}"
                        Command="{Binding ResetSettingsCommand}"
                        Content="↩  Reset to Defaults"/>
            </StackPanel>

            <!-- bottom padding -->
            <Rectangle Height="30"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
