<UserControl x:Class="Assistant.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource AppBackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="40,32,40,32">
        <StackPanel MaxWidth="900" HorizontalAlignment="Left">

            <!-- Page title -->
            <StackPanel Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="⚙️" FontSize="32" Margin="0,0,16,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Settings" FontSize="28" FontWeight="Bold"
                               Foreground="#FFEAEAEA"/>
                </StackPanel>
                <TextBlock Text="Configure API key, model parameters, and privacy options."
                           Foreground="#FF999999" FontSize="14" Margin="52,0,0,0"/>
            </StackPanel>
            
            <Rectangle Height="2" Fill="#FF333333" Margin="0,0,0,32"/>

            <!-- ══════════════════════════════════════════
                 SECTION: API KEY
                 ══════════════════════════════════════════ -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock Text="🔑" FontSize="22" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <TextBlock Text="API KEY" FontSize="19" FontWeight="Bold" Foreground="#FF2A7FFF" VerticalAlignment="Center"/>
            </StackPanel>

            <Border Background="#FF1A1A1A"
                    BorderBrush="#FF2A7FFF"
                    BorderThickness="2" 
                    CornerRadius="12" 
                    Padding="28,24"
                    Margin="0,0,0,32">
                <StackPanel>
                    <!-- Privacy notice -->
                    <Border Background="#FF0D2847" 
                            CornerRadius="8" 
                            Padding="18,14" 
                            Margin="0,0,0,18" 
                            BorderBrush="#FF2A7FFF" 
                            BorderThickness="1.5">
                        <TextBlock TextWrapping="Wrap" FontSize="13"
                                   Foreground="#FF79C0FF"
                                   LineHeight="22">
                            <Run FontWeight="Bold">🔒 Security Notice: </Run>
                            <Run>Your API key is stored in </Run>
                            <Run FontWeight="Bold">Windows Credential Manager</Run>
                            <Run>, not in any file on disk. Never logged or transmitted except directly to Google Gemini API.</Run>
                        </TextBlock>
                    </Border>

                    <TextBlock Text="Enter your Gemini API key:"
                               Foreground="#FFAAAAAA"
                               FontSize="13" 
                               FontWeight="Medium"
                               Margin="0,0,0,10"/>

                    <PasswordBox x:Name="ApiKeyPasswordBox"
                                 Style="{StaticResource ModernPasswordBox}"
                                 PasswordChanged="ApiKeyPasswordBox_PasswordChanged"
                                 Height="42"
                                 FontSize="13"
                                 Margin="0,0,0,16"/>

                    <!-- Action buttons -->
                    <WrapPanel Margin="0,0,0,18" HorizontalAlignment="Left">
                        <Button Style="{StaticResource PrimaryButton}"
                                Command="{Binding SaveApiKeyCommand}"
                                Content="💾  Save Key"
                                Height="40"
                                Padding="22,0"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Margin="0,0,10,0"/>
                        <Button Style="{StaticResource SecondaryButton}"
                                Command="{Binding ValidateApiKeyCommand}"
                                Content="✅  Test"
                                Height="40"
                                Padding="22,0"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Margin="0,0,10,0"/>
                        <Button Style="{StaticResource DangerButton}"
                                Command="{Binding DeleteApiKeyCommand}"
                                Content="🗑  Remove"
                                Height="40"
                                Padding="22,0"
                                FontSize="13"
                                FontWeight="SemiBold"/>
                    </WrapPanel>

                    <!-- Status message -->
                    <TextBlock Text="{Binding ApiKeyStatus}"
                               TextWrapping="Wrap"
                               FontSize="13" 
                               FontWeight="SemiBold"
                               Margin="0,0,0,12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#FF3FB950"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsApiKeyStatusError}" Value="True">
                                        <Setter Property="Foreground" Value="#FFF85149"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsValidating}" Value="True">
                                        <Setter Property="Foreground" Value="#FFFBBF24"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,0">
                        <Run Text="Get free API key: " Foreground="#FF888888"/>
                        <Hyperlink NavigateUri="https://ai.google.dev" RequestNavigate="Hyperlink_RequestNavigate" Foreground="#FF58A6FF">ai.google.dev</Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════════
                 SECTION: MODEL
                 ══════════════════════════════════════════ -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock Text="🤖" FontSize="22" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <TextBlock Text="MODEL &amp; GENERATION" FontSize="19" FontWeight="Bold" Foreground="#FF9333EA" VerticalAlignment="Center"/>
            </StackPanel>

            <Border Background="#FF1A1A1A"
                    BorderBrush="#FF9333EA"
                    BorderThickness="2" 
                    CornerRadius="12" 
                    Padding="28,24"
                    Margin="0,0,0,32">
                <StackPanel>

                    <!-- Model selector -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Model" VerticalAlignment="Center"
                                   Foreground="#FFAAAAAA" FontSize="13" FontWeight="SemiBold"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding AvailableModels}"
                                  SelectedItem="{Binding SelectedModel}"
                                  Height="38"
                                  FontSize="13"/>
                    </Grid>

                    <!-- Temperature slider -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Temperature" VerticalAlignment="Center"
                                   Foreground="#FFAAAAAA" FontSize="13" FontWeight="SemiBold"/>
                        <Slider Grid.Column="1" Minimum="0" Maximum="1" TickFrequency="0.05"
                                Value="{Binding Temperature}" IsSnapToTickEnabled="True"
                                VerticalAlignment="Center"
                                Height="22"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Temperature, Converter={StaticResource TempToPercent}}"
                                   Foreground="#FF9333EA"
                                   FontSize="15" 
                                   FontWeight="Bold"
                                   HorizontalAlignment="Right" 
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Max tokens -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Max output tokens" VerticalAlignment="Center"
                                   Foreground="#FFAAAAAA" FontSize="13" FontWeight="SemiBold"/>
                        <TextBox Grid.Column="1"
                                 Style="{StaticResource ModernTextBox}"
                                 Text="{Binding MaxTokens, UpdateSourceTrigger=PropertyChanged}"
                                 Height="38"
                                 FontSize="13"
                                 Foreground="#FFEAEAEA"/>
                    </Grid>

                    <!-- Streaming toggle -->
                    <CheckBox IsChecked="{Binding UseStreaming}"
                              Content="Enable streaming responses (shows text as it generates)"
                              FontSize="13"
                              Margin="0,0,0,20"/>

                    <!-- System prompt -->
                    <TextBlock Text="System prompt" Margin="0,0,0,10"
                               Foreground="#FFAAAAAA" FontSize="13" FontWeight="SemiBold"/>
                    <TextBox Style="{StaticResource ModernTextBox}"
                             Text="{Binding SystemPrompt, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Height="95"
                             FontSize="13"
                             VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════════
                 SECTION: PRIVACY
                 ══════════════════════════════════════════ -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock Text="🔒" FontSize="22" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <TextBlock Text="PRIVACY" FontSize="19" FontWeight="Bold" Foreground="#FF10B981" VerticalAlignment="Center"/>
            </StackPanel>

            <Border Background="#FF1A1A1A"
                    BorderBrush="#FF10B981"
                    BorderThickness="2" 
                    CornerRadius="12" 
                    Padding="28,24"
                    Margin="0,0,0,32">
                <StackPanel>
                    <!-- Privacy mode explanation -->
                    <Border Background="#FF0A1F1A" 
                            CornerRadius="8" 
                            Padding="18,16" 
                            Margin="0,0,0,18" 
                            BorderBrush="#FF10B981" 
                            BorderThickness="1.5">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" Margin="0,0,0,10" FontSize="14"
                                       Foreground="#FF10B981">✅ Privacy Mode Active</TextBlock>
                            <TextBlock TextWrapping="Wrap" FontSize="13"
                                       Foreground="#FFCCCCCC"
                                       LineHeight="22">
Uses <Run FontWeight="SemiBold" Foreground="#FF10B981">SetWindowDisplayAffinity(WDA_EXCLUDEFROMCAPTURE)</Run> to hide window content from screen capture tools.
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" FontSize="13" Margin="0,12,0,0"
                                       Foreground="#FF10B981"
                                       FontWeight="Medium"
                                       LineHeight="22">
✅ <Run FontWeight="Bold">Tested &amp; Working:</Run> Zoom, Discord, OBS, Teams, Snipping Tool, Xbox Game Bar (Windows 10 2004+)
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,10,0,0"
                                       Foreground="#FF888888"
                                       LineHeight="20">
⚠️ May not work on: older Windows versions, hardware recorders, RDP, or TeamViewer
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <CheckBox Content="Enable logging (errors and metadata only — no chat content)"
                              IsChecked="{Binding EnableLogging}" 
                              FontSize="13"
                              Margin="0,8"/>
                    <CheckBox IsChecked="{Binding LogConversations}" 
                              FontSize="13"
                              Margin="0,8">
                        <TextBlock TextWrapping="Wrap">
                            <Run>Log conversation content to disk</Run>
                            <Run Foreground="#FFFBBF24" FontWeight="Medium"> (off by default)</Run>
                        </TextBlock>
                    </CheckBox>
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════════
                 SECTION: WINDOW BEHAVIOUR
                 ══════════════════════════════════════════ -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock Text="🖥️" FontSize="22" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <TextBlock Text="WINDOW BEHAVIOUR" FontSize="19" FontWeight="Bold" Foreground="#FF6366F1" VerticalAlignment="Center"/>
            </StackPanel>

            <Border Background="#FF1A1A1A"
                    BorderBrush="#FF6366F1"
                    BorderThickness="2" 
                    CornerRadius="12" 
                    Padding="28,24"
                    Margin="0,0,0,32">
                <StackPanel>
                    <CheckBox Content="Minimise to tray on close (instead of quitting)"
                              IsChecked="{Binding MinimizeToTray}" 
                              FontSize="13"
                              Margin="0,8"/>
                    <CheckBox Content="Start minimised to tray"
                              IsChecked="{Binding StartMinimized}" 
                              FontSize="13"
                              Margin="0,8"/>
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════════
                 ACTION BUTTONS
                 ══════════════════════════════════════════ -->
            <Separator Margin="0,24,0,20" Background="{StaticResource BorderBrush}"/>
            
            <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                <Button Style="{StaticResource PrimaryButton}"
                        Command="{Binding SaveSettingsCommand}"
                        Content="💾  Save Settings"
                        Padding="20,10"
                        FontSize="13"
                        Margin="0,0,12,0"/>
                <Button Style="{StaticResource SecondaryButton}"
                        Command="{Binding ResetSettingsCommand}"
                        Content="↩  Reset to Defaults"
                        Padding="20,10"
                        FontSize="13"/>
            </StackPanel>

            <!-- bottom padding -->
            <Rectangle Height="30"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
