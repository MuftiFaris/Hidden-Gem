<UserControl x:Class="Assistant.Views.SettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="{StaticResource AppBackgroundBrush}">
 <!-- Hallmark: Workbench; existing dark-blue tokens / Segoe UI; motion-cut.
      Pre-emit critique: Philosophy 4, Hierarchy 5, Execution 4, Specificity 5, Restraint 5, Variety 4. -->
 <UserControl.Resources>
  <Style x:Key="SettingsHeading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
   <Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,8"/>
  </Style>
  <Style x:Key="SettingsHint" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
   <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontSize" Value="12"/><Setter Property="LineHeight" Value="18"/>
  </Style>
  <Style x:Key="SettingsLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
   <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,16,0,8"/>
  </Style>
  <Style x:Key="SettingsCheck" TargetType="CheckBox">
   <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/><Setter Property="Margin" Value="0,8"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
    <Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border x:Name="Box" Width="17" Height="17" CornerRadius="4" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource InputBackgroundBrush}" VerticalAlignment="Top" Margin="0,1,7,0"/>
     <Path x:Name="Tick" Data="M 0 4 L 3 7 L 9 0" Stroke="{StaticResource AccentForegroundBrush}" StrokeThickness="2" Width="10" Height="9" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3,5,0,0" Visibility="Collapsed"/>
     <ContentPresenter Grid.Column="1"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/><Setter TargetName="Box" Property="BorderThickness" Value="2"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </UserControl.Resources>
 <Grid Margin="28,24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,24">
   <TextBlock Text="Settings" FontSize="26" FontWeight="SemiBold"/>
   <TextBlock Text="Connect Gemini or 9Router and choose a model for quick responses." Style="{StaticResource SettingsHint}" Margin="0,6,0,0"/>
  </StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="0,0,12,0">
    <TextBlock Text="Connection" Style="{StaticResource SettingsHeading}"/>
    <TextBlock Text="Your key stays in Windows Credential Manager. A connection test sends a small generation request." Style="{StaticResource SettingsHint}"/>
    <TextBlock Text="Provider" Style="{StaticResource SettingsLabel}"/>
    <ComboBox ItemsSource="{Binding AvailableProviders}" SelectedItem="{Binding Provider}" IsEnabled="{Binding CanEditConnection}" AutomationProperties.Name="AI provider"/>
    <StackPanel Visibility="{Binding IsRouterProvider, Converter={StaticResource BoolToVisibility}}">
     <TextBlock Text="9Router API base URL" Style="{StaticResource SettingsLabel}"/>
     <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding RouterBaseUrl, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditConnection}" Height="42"/>
     <TextBlock Text="Keep 9Router running in CMD. Copy the /v1 URL and API key from its dashboard." Style="{StaticResource SettingsHint}" Margin="0,6,0,0"/>
    </StackPanel>
    <TextBlock Text="API key for selected provider" Style="{StaticResource SettingsLabel}"/>
    <PasswordBox x:Name="ApiKeyPasswordBox" Style="{StaticResource ModernPasswordBox}" PasswordChanged="ApiKeyPasswordBox_PasswordChanged" Height="42" IsEnabled="{Binding CanEditConnection}" AutomationProperties.Name="Gemini API key"/>
    <WrapPanel Margin="0,12,0,0">
     <Button Content="Save key" Command="{Binding SaveApiKeyCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
     <Button Content="Test connection" Command="{Binding ValidateApiKeyCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"/>
     <Button Content="Remove key" Command="{Binding DeleteApiKeyCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8"/>
    </WrapPanel>
    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,4,0,12">
     <TextBlock Text="{Binding ApiKeyStatus}" TextWrapping="Wrap" LineHeight="19">
      <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
       <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
       <Style.Triggers><DataTrigger Binding="{Binding IsApiKeyStatusError}" Value="True"><Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/></DataTrigger><DataTrigger Binding="{Binding IsValidating}" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/></DataTrigger></Style.Triggers>
      </Style></TextBlock.Style>
     </TextBlock>
    </Border>
    <TextBlock Style="{StaticResource SettingsHint}">
     <Hyperlink NavigateUri="https://aistudio.google.com/apikey" RequestNavigate="Hyperlink_RequestNavigate">Create API key</Hyperlink>
     <Run Text="   ·   "/><Hyperlink NavigateUri="https://aistudio.google.com/usage" RequestNavigate="Hyperlink_RequestNavigate">Usage and API quota</Hyperlink>
    </TextBlock>
    <Separator Margin="0,24,0,20"/>
    <TextBlock Text="Model &amp; responses" Style="{StaticResource SettingsHeading}"/>
    <TextBlock Text="Gemini Auto selects Flash models. For 9Router, use an exact dashboard model ID. A listed model is not a promise of free access." Style="{StaticResource SettingsHint}"/>
    <TextBlock Text="Model" Style="{StaticResource SettingsLabel}"/>
    <ComboBox ItemsSource="{Binding AvailableModels}" SelectedItem="{Binding SelectedModel, Mode=TwoWay}" IsEnabled="{Binding CanEditConnection}" AutomationProperties.Name="Gemini model"/>
    <WrapPanel Margin="0,10,0,0">
     <Button Content="Use Auto (Flash)" Visibility="{Binding IsGeminiProvider, Converter={StaticResource BoolToVisibility}}" Command="{Binding UseRecommendedModelCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
     <Button Content="Refresh models" Command="{Binding RefreshModelsCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8"/>
    </WrapPanel>
    <StackPanel Visibility="{Binding IsRouterProvider, Converter={StaticResource BoolToVisibility}}">
     <TextBlock Text="Exact 9Router model ID" Style="{StaticResource SettingsLabel}"/>
     <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding SelectedModel, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditConnection}" Height="42"/>
     <TextBlock Text="Screen reading needs a vision-capable route. Voice needs a separate STT model configured in 9Router." Style="{StaticResource SettingsHint}" Margin="0,6,0,0"/>
     <TextBlock Text="9Router speech-to-text model ID (optional)" Style="{StaticResource SettingsLabel}"/>
     <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding RouterTranscriptionModel, UpdateSourceTrigger=PropertyChanged}" Height="42"/>
    </StackPanel>
    <TextBlock Text="Request timeout (seconds)" Style="{StaticResource SettingsLabel}"/>
    <TextBox x:Name="TimeoutInput" Validation.Error="TokenInput_ValidationError" Style="{StaticResource ModernTextBox}" Text="{Binding RequestTimeoutSeconds, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}" Width="180" Height="40" HorizontalAlignment="Left"/>
    <TextBlock Text="Default: 45 seconds total. Streaming stops if no answer text arrives within 20 seconds." Style="{StaticResource SettingsHint}" Margin="0,6,0,0"/>
    <TextBlock Text="Temperature" Style="{StaticResource SettingsLabel}"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
     <Slider Minimum="0" Maximum="2" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding Temperature}" AutomationProperties.Name="Temperature"/>
     <TextBlock Grid.Column="1" Text="{Binding Temperature, StringFormat={}{0:0.0}}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
    </Grid>
    <TextBlock Text="Lower values keep answers focused. Higher values add variety." Style="{StaticResource SettingsHint}"/>
    <TextBlock Text="Max output tokens" Style="{StaticResource SettingsLabel}"/>
    <TextBox x:Name="TokenInput" Validation.Error="TokenInput_ValidationError" Style="{StaticResource ModernTextBox}" Text="{Binding MaxTokens, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}" Width="180" HorizontalAlignment="Left" Height="40" AutomationProperties.Name="Max output tokens"/>
    <TextBlock Text="128–32768. This budget can include reasoning tokens." Style="{StaticResource SettingsHint}" Margin="0,6,0,10"/>
    <CheckBox IsChecked="{Binding UseStreaming}" Style="{StaticResource SettingsCheck}"><TextBlock Text="Show responses as they generate" TextWrapping="Wrap"/></CheckBox>
    <TextBlock Text="Assistant persona" Style="{StaticResource SettingsLabel}"/>
    <Button Content="Use default persona" Command="{Binding ResetPersonaCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,0,0,10"/>
    <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding SystemPrompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="180" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="System prompt"/>
    <Separator Margin="0,24,0,20"/>
    <TextBlock Text="Privacy &amp; logging" Style="{StaticResource SettingsHeading}"/>
    <TextBlock Text="Screen-capture privacy mode is controlled from the main window. Selected-window images and speaker audio are sent to Gemini when live analysis is enabled." Style="{StaticResource SettingsHint}" Margin="0,0,0,8"/>
    <CheckBox IsChecked="{Binding EnableLogging}" Style="{StaticResource SettingsCheck}"><TextBlock Text="Enable diagnostic logs" TextWrapping="Wrap"/></CheckBox>
    <CheckBox IsChecked="{Binding LogConversations}" Style="{StaticResource SettingsCheck}"><TextBlock Text="Include conversation content in logs" TextWrapping="Wrap"/></CheckBox>
    <Separator Margin="0,24,0,20"/>
    <TextBlock Text="Window behavior" Style="{StaticResource SettingsHeading}"/>
    <CheckBox IsChecked="{Binding MinimizeToTray}" Style="{StaticResource SettingsCheck}"><TextBlock Text="Keep running in the tray when I close the window" TextWrapping="Wrap"/></CheckBox>
    <CheckBox IsChecked="{Binding StartMinimized}" Style="{StaticResource SettingsCheck}"><TextBlock Text="Start minimized to the tray" TextWrapping="Wrap"/></CheckBox>
    <Border Height="16"/>
   </StackPanel>
  </ScrollViewer>
  <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,16,0,0">
   <StackPanel>
    <TextBlock Text="{Binding SettingsStatus}" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,8"/>
    <WrapPanel>
     <Button Content="Save settings" Command="{Binding SaveSettingsCommand}" Click="SaveSettings_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,4"/>
     <Button Content="Reset defaults" Command="{Binding ResetSettingsCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,4"/>
    </WrapPanel>
   </StackPanel>
  </Border>
 </Grid>
</UserControl>

