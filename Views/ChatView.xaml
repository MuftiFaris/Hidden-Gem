<UserControl x:Class="Assistant.Views.ChatView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:models="clr-namespace:Assistant.Models"
 xmlns:controls="clr-namespace:Assistant.Controls"
 Background="{StaticResource AppBackgroundBrush}">
 <!-- Hallmark: native chat workbench, existing tokens; selectable prose and message actions. -->
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="20,12,20,8" LastChildFill="True">
   <WrapPanel DockPanel.Dock="Right">
    <Button Content="Copy chat" Style="{StaticResource SecondaryButton}" Click="CopyChat_Click" Margin="0,0,8,0" Padding="9,5" FontSize="11"/>
    <Button Content="Export chat" Style="{StaticResource SecondaryButton}" Click="ExportChat_Click" Margin="0,0,8,0" Padding="9,5" FontSize="11"/>
    <Button Content="Clear" Style="{StaticResource SecondaryButton}" Command="{Binding ClearCommand}" Padding="9,5" FontSize="11"/>
   </WrapPanel>
   <TextBlock x:Name="ActionStatus" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap"/>
  </DockPanel>
  <ScrollViewer Grid.Row="1" x:Name="MessagesScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,8,20,16">
   <ItemsControl x:Name="MessagesList" ItemsSource="{Binding Messages}">
    <ItemsControl.ItemTemplate>
     <DataTemplate DataType="{x:Type models:ChatMessage}">
      <Grid Margin="0,8,0,16">
       <Border HorizontalAlignment="Right" MaxWidth="620" MinWidth="100" CornerRadius="14,14,3,14" Padding="16,12" Margin="48,0,0,0" Background="{StaticResource UserBubbleBrush}">
        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Role}" Value="{x:Static models:MessageRole.User}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
        <StackPanel>
         <controls:MarkdownView Text="{Binding Content}" ParseMarkdown="False"/>
         <DockPanel Margin="0,8,0,0" LastChildFill="False">
          <TextBlock Text="{Binding Timestamp, Converter={StaticResource TimeConverter}}" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
          <Button Content="Copy" Click="CopyMessage_Click" Padding="8,3" FontSize="11" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"/>
          <Button Content="Export" Click="ExportMessage_Click" Padding="8,3" FontSize="11" Style="{StaticResource SecondaryButton}" IsEnabled="{Binding CanExport}"/>
         </DockPanel>
        </StackPanel>
       </Border>
       <Border HorizontalAlignment="Stretch" MaxWidth="800" Padding="0,6,0,0" Margin="0,0,16,0">
        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Role}" Value="{x:Static models:MessageRole.Assistant}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
        <StackPanel>
         <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
          <Image Source="pack://application:,,,/HiddenGem;component/Assets/app.png" Width="23" Height="23" Margin="0,0,9,0"/>
          <TextBlock Text="{Binding RoleDisplayName}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
          <TextBlock Text="  ·  generating" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" VerticalAlignment="Center" Visibility="{Binding IsStreaming, Converter={StaticResource BoolToVisibility}}"/>
         </StackPanel>
         <controls:MarkdownView Text="{Binding Content}" IsStreaming="{Binding IsStreaming}" IsError="{Binding IsError}"/>
         <WrapPanel Margin="0,8,0,0">
          <Button Content="Copy" Click="CopyMessage_Click" Padding="9,4" FontSize="11" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
          <Button Content="Export" Click="ExportMessage_Click" Padding="9,4" FontSize="11" Style="{StaticResource SecondaryButton}" IsEnabled="{Binding CanExport}" Margin="0,0,12,0"/>
          <TextBlock Text="{Binding Timestamp, Converter={StaticResource TimeConverter}}" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"/>
         </WrapPanel>
        </StackPanel>
       </Border>
       <Border HorizontalAlignment="Center" MaxWidth="600" Padding="12,8" Background="{StaticResource SystemBubbleBrush}" CornerRadius="6">
        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Role}" Value="{x:Static models:MessageRole.System}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
        <TextBlock Text="{Binding Content}" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}"/>
       </Border>
      </Grid>
     </DataTemplate>
    </ItemsControl.ItemTemplate>
   </ItemsControl>
  </ScrollViewer>
  <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,12">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBox x:Name="InputBox" Grid.Column="0" Style="{StaticResource ModernTextBox}" Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="44" MaxHeight="140" VerticalContentAlignment="Center" KeyDown="InputBox_KeyDown" AutomationProperties.Name="Message"/>
    <Button Grid.Column="1" Content="Stop" Command="{Binding CancelCommand}" Visibility="{Binding IsSending, Converter={StaticResource BoolToVisibility}}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Padding="12,8"/>
    <Button Grid.Column="2" Content="Send" Command="{Binding SendCommand}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Padding="14,8"/>
   </Grid>
  </Border>
  <TextBlock Grid.Row="3" Text="{Binding SendStatus}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="16,0,16,8"/>
 </Grid>
</UserControl>
