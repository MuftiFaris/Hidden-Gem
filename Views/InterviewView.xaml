<UserControl x:Class="Assistant.Views.InterviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource AppBackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="40,32,40,32">
        <StackPanel MaxWidth="900" HorizontalAlignment="Left">

            <!-- Page title -->
            <StackPanel Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="🎯" FontSize="32" Margin="0,0,16,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Interview Assistant" FontSize="28" FontWeight="Bold"
                               Foreground="#FFEAEAEA"/>
                </StackPanel>
                <TextBlock Text="Auto-respond to interview questions in real-time. Captures audio from Zoom, Discord, GMeet."
                           Foreground="#FF999999" FontSize="14" Margin="52,0,0,0"/>
            </StackPanel>

            <Rectangle Height="2" Fill="#FF333333" Margin="0,0,0,32"/>

            <!-- ══════════════════════════════════════════
                 SECTION: CAPTURE CONTROLS
                 ══════════════════════════════════════════ -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock Text="🎤" FontSize="22" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <TextBlock Text="AUDIO CAPTURE" FontSize="19" FontWeight="Bold" Foreground="#FF58A6FF" VerticalAlignment="Center"/>
            </StackPanel>

            <Border Background="#FF1A1A1A"
                    BorderBrush="#FF58A6FF"
                    BorderThickness="2" 
                    CornerRadius="12" 
                    Padding="28,24"
                    Margin="0,0,0,32">
                <StackPanel>
                    <TextBlock Text="Captures audio from speakers (Zoom, Discord, GMeet participants)."
                               Foreground="#FFB0B0B0" FontSize="13" Margin="0,0,0,16"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Button Style="{StaticResource PrimaryButton}"
                                Command="{Binding StartCaptureCommand}"
                                Content="🎤  Start Listening"
                                Height="40"
                                Padding="22,0"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Margin="0,0,10,0"/>
                        <Button Style="{StaticResource SecondaryButton}"
                                Command="{Binding StopCaptureCommand}"
                                Content="⏹️  Stop"
                                Height="40"
                                Padding="22,0"
                                FontSize="13"
                                FontWeight="SemiBold"/>
                    </StackPanel>

                    <Border Background="#FF0D2847" 
                            CornerRadius="8" 
                            Padding="14,12" 
                            BorderBrush="#FF58A6FF" 
                            BorderThickness="1">
                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="#FF79C0FF"
                                   FontSize="12"
                                   TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════════
                 SECTION: AUTO-RESPONSE
                 ══════════════════════════════════════════ -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock Text="⚡" FontSize="22" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <TextBlock Text="AUTO-RESPONSE" FontSize="19" FontWeight="Bold" Foreground="#FF10B981" VerticalAlignment="Center"/>
            </StackPanel>

            <Border Background="#FF1A1A1A"
                    BorderBrush="#FF10B981"
                    BorderThickness="2" 
                    CornerRadius="12" 
                    Padding="28,24"
                    Margin="0,0,0,32">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <CheckBox IsChecked="{Binding IsAutoResponseEnabled}"
                                  FontSize="13"
                                  Margin="0"
                                  VerticalAlignment="Center"/>
                        <TextBlock Text="Enable auto-response (generates answers automatically)"
                                   Foreground="#FFB0B0B0" FontSize="13" Margin="12,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Border Background="#FF0F1F1A" 
                            CornerRadius="8" 
                            Padding="16,14" 
                            BorderBrush="#FF10B981" 
                            BorderThickness="1.5"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" Margin="0,0,0,8" FontSize="13"
                                       Foreground="#FF10B981">How it works:</TextBlock>
                            <TextBlock TextWrapping="Wrap" FontSize="12"
                                       Foreground="#FFCCCCCC"
                                       LineHeight="20">
1. Start capturing audio from speakers
2. System listens for interview questions
3. When a question is detected:
   - Captures current screen
   - Transcribes the question
   - Generates intelligent response using Gemini AI
4. Response appears below for review/copying
5. Use answers manually or copy to chat
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════════
                 SECTION: CURRENT RESPONSE
                 ══════════════════════════════════════════ -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock Text="💡" FontSize="22" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <TextBlock Text="CURRENT RESPONSE" FontSize="19" FontWeight="Bold" Foreground="#FFFBBF24" VerticalAlignment="Center"/>
            </StackPanel>

            <Border Background="#FF1A1A1A"
                    BorderBrush="#FFFBBF24"
                    BorderThickness="2" 
                    CornerRadius="12" 
                    Padding="28,24"
                    Margin="0,0,0,32">
                <StackPanel>
                    <!-- Question -->
                    <TextBlock Text="Question:"
                               Foreground="#FFAAAAAA"
                               FontSize="12" 
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>
                    <TextBox Style="{StaticResource ModernTextBox}"
                             Text="{Binding CurrentQuestion, Mode=OneWay}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Height="60"
                             FontSize="12"
                             Margin="0,0,0,20"
                             Foreground="#FFB0B0B0"/>

                    <!-- Response -->
                    <TextBlock Text="Generated Response:"
                               Foreground="#FFAAAAAA"
                               FontSize="12" 
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>
                    <TextBox Style="{StaticResource ModernTextBox}"
                             Text="{Binding CurrentResponse, Mode=OneWay}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Height="120"
                             FontSize="12"
                             Margin="0,0,0,16"
                             Foreground="#FFEAEAEA"/>

                    <Button Style="{StaticResource PrimaryButton}"
                            Command="{Binding CopyResponseCommand}"
                            Content="📋  Copy Response"
                            Height="38"
                            Padding="20,0"
                            FontSize="12"
                            FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════════
                 SECTION: HISTORY
                 ══════════════════════════════════════════ -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock Text="📚" FontSize="22" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <TextBlock Text="EXCHANGE HISTORY" FontSize="19" FontWeight="Bold" Foreground="#FF9333EA" VerticalAlignment="Center"/>
            </StackPanel>

            <Border Background="#FF1A1A1A"
                    BorderBrush="#FF9333EA"
                    BorderThickness="2" 
                    CornerRadius="12" 
                    Padding="28,24"
                    Margin="0,0,0,32">
                <StackPanel>
                    <ListBox ItemsSource="{Binding Exchanges}"
                             Height="200"
                             Background="{StaticResource InputBackgroundBrush}"
                             BorderBrush="{StaticResource BorderBrush}"
                             BorderThickness="1"
                             Margin="0,0,0,16"
                             FontSize="12">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="8,4">
                                    <TextBlock Text="{Binding Timestamp, StringFormat='🕐 {0:HH:mm:ss}'}"
                                               Foreground="#FF9333EA" 
                                               FontSize="11"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Question}"
                                               Foreground="#FFCCCCCC"
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Style="{StaticResource SecondaryButton}"
                            Command="{Binding ClearHistoryCommand}"
                            Content="🗑️  Clear History"
                            Height="36"
                            Padding="18,0"
                            FontSize="12"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════════
                 WARNING / NOTES
                 ══════════════════════════════════════════ -->
            <Border Background="#FF221A0D" 
                    CornerRadius="8" 
                    Padding="20,16" 
                    BorderBrush="#FFFBBF24" 
                    BorderThickness="1.5"
                    Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock FontWeight="Bold" Margin="0,0,0,10" FontSize="13"
                               Foreground="#FFFBBF24">⚠️  Important Notes:</TextBlock>
                    <TextBlock TextWrapping="Wrap" FontSize="12"
                               Foreground="#FFCCCCCC"
                               LineHeight="20">
• Audio capture requires system audio routing (WASAPI loopback)
• Generated responses are AI-assisted — always review before using
• Use responsibly in interviews; AI may not catch context nuances
• Responses are not stored or transmitted except to Gemini API
• Practice with real questions before using in actual interviews
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- bottom padding -->
            <Rectangle Height="30"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
