<Window x:Class="Assistant.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:Assistant.Views"
        xmlns:vm="clr-namespace:Assistant.ViewModels"
        mc:Ignorable="d"
        Title="Hidden Gem"
        Height="720" Width="1050"
        MinHeight="520" MinWidth="720"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        SourceInitialized="Window_SourceInitialized"
        Closing="Window_Closing">

    <!-- DataTemplates: ContentPresenter picks the right view for each VM type -->
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:ChatViewModel}">
            <views:ChatView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
    </Window.Resources>

    <!-- Outer border gives us rounded corners + the 1 px border on the frameless window -->
    <Border CornerRadius="{StaticResource WindowCornerRadius}"
            Background="{   StaticResource AppBackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            ClipToBounds="True">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>   <!-- Title bar -->
                <RowDefinition Height="*"/>    <!-- Content   -->
                <RowDefinition Height="24"/>   <!-- Status bar-->
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/> <!-- Sidebar -->
                <ColumnDefinition Width="*"/>   <!-- Main    -->
            </Grid.ColumnDefinitions>

            <!-- ══════════════════════════════════════════════
                 TITLE BAR  (row 0, spans both columns)
                 ══════════════════════════════════════════════ -->
            <Border Grid.Row="0" Grid.ColumnSpan="2"
                    Background="{StaticResource SidebarBrush}"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <!-- App identity -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                        <TextBlock Text="💎" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Hidden Gem"
                                   FontWeight="SemiBold" FontSize="13"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Right side: privacy badge + window buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">

                        <!-- Privacy mode badge (visible only when active) -->
                        <Border Margin="0,0,12,0" CornerRadius="10" Padding="8,3"
                                Background="{StaticResource PrivacyActiveBrush}"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsPrivacyModeEnabled,
                                             Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔒" FontSize="11" Margin="0,0,4,0"/>
                                <TextBlock Text="PRIVATE" FontSize="10" FontWeight="Bold"
                                           Foreground="White"/>
                            </StackPanel>
                        </Border>

                        <Button Style="{StaticResource WinCtrlButton}"
                                Content="⎯" Click="MinimizeButton_Click"/>
                        <Button Style="{StaticResource WinCtrlButton}"
                                Content="⬜" Click="MaximizeButton_Click"/>
                        <Button Style="{StaticResource WinCloseButton}"
                                Content="✕" Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════
                 SIDEBAR  (col 0, row 1)
                 ══════════════════════════════════════════════ -->
            <Border Grid.Row="1" Grid.Column="0"
                    Background="{StaticResource SidebarBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Navigation -->
                    <StackPanel Grid.Row="0" Margin="8,12,8,0">
                        <TextBlock Text="NAVIGATION"
                                   Style="{StaticResource SectionHeader}"
                                   Margin="12,0,0,8"/>

                        <!-- Chat nav button — active style when IsChatSelected -->
                        <Button Command="{Binding NavigateToChatCommand}"
                                Style="{StaticResource NavButton}"
                                x:Name="ChatNavBtn">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💬" FontSize="15" Margin="0,0,10,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="Chat" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateToSettingsCommand}"
                                Style="{StaticResource NavButton}"
                                x:Name="SettingsNavBtn">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙️" FontSize="15" Margin="0,0,10,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="Settings" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ShowOverlayCommand}"
                                Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🪟" FontSize="15" Margin="0,0,10,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="Overlay" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Bottom: Privacy toggle -->
                    <StackPanel Grid.Row="1" Margin="8,0,8,12">
                        <Separator/>

                        <Button Command="{Binding TogglePrivacyModeCommand}"
                                Style="{StaticResource NavButton}"
                                ToolTip="Toggle privacy mode (SetWindowDisplayAffinity)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="🔓"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPrivacyModeEnabled}" Value="True">
                                                    <Setter Property="Text" Value="🔒"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Privacy Mode" FontSize="12"/>
                                    <TextBlock FontSize="10" Foreground="{StaticResource SecondaryTextBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Off"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPrivacyModeEnabled}" Value="True">
                                                        <Setter Property="Text" Value="On — screen capture blocked"/>
                                                        <Setter Property="Foreground" Value="{StaticResource PrivacyActiveBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════
                 MAIN CONTENT  (col 1, row 1)
                 ══════════════════════════════════════════════ -->
            <ContentPresenter Grid.Row="1" Grid.Column="1"
                              Content="{Binding CurrentView}"/>

            <!-- ══════════════════════════════════════════════
                 STATUS BAR  (row 2, spans both columns)
                 ══════════════════════════════════════════════ -->
            <Border Grid.Row="2" Grid.ColumnSpan="2"
                    Background="{StaticResource SidebarBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0">
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Margin="14,0"
                           TextTrimming="CharacterEllipsis"/>
            </Border>
        </Grid>
    </Border>
</Window>
