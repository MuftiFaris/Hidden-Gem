<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ══════════════════════════════════════════════════
         COLOUR PALETTE  —  Deep-space dark theme
         ══════════════════════════════════════════════════ -->

    <!-- Backgrounds -->
    <SolidColorBrush x:Key="AppBackgroundBrush"    Color="#FF0D1117"/>
    <SolidColorBrush x:Key="SidebarBrush"          Color="#FF161B22"/>
    <SolidColorBrush x:Key="SurfaceBrush"          Color="#FF1C2128"/>
    <SolidColorBrush x:Key="Surface2Brush"         Color="#FF22272E"/>
    <SolidColorBrush x:Key="InputBackgroundBrush"  Color="#FF1C2128"/>

    <!-- Text -->
    <SolidColorBrush x:Key="PrimaryTextBrush"      Color="#FFE6EDF3"/>
    <SolidColorBrush x:Key="SecondaryTextBrush"    Color="#FF8B949E"/>
    <SolidColorBrush x:Key="MutedTextBrush"        Color="#FF484F58"/>
    <SolidColorBrush x:Key="PlaceholderTextBrush"  Color="#FF484F58"/>

    <!-- Accent (GitHub Copilot blue) -->
    <SolidColorBrush x:Key="AccentBrush"           Color="#FF58A6FF"/>
    <SolidColorBrush x:Key="AccentHoverBrush"      Color="#FF79C0FF"/>
    <SolidColorBrush x:Key="AccentPressedBrush"    Color="#FF388BFD"/>
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FF0D1117"/>

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderBrush"           Color="#FF30363D"/>
    <SolidColorBrush x:Key="BorderHoverBrush"      Color="#FF58A6FF"/>

    <!-- Chat bubbles -->
    <SolidColorBrush x:Key="UserBubbleBrush"       Color="#FF1F4C8C"/>
    <SolidColorBrush x:Key="AssistantBubbleBrush"  Color="#FF1C2128"/>
    <SolidColorBrush x:Key="SystemBubbleBrush"     Color="#FF22272E"/>

    <!-- Status colours -->
    <SolidColorBrush x:Key="SuccessBrush"          Color="#FF3FB950"/>
    <SolidColorBrush x:Key="ErrorBrush"            Color="#FFF85149"/>
    <SolidColorBrush x:Key="WarningBrush"          Color="#FFD29922"/>

    <!-- Privacy badge -->
    <SolidColorBrush x:Key="PrivacyActiveBrush"    Color="#FFF85149"/>
    <SolidColorBrush x:Key="PrivacyInactiveBrush"  Color="#FF30363D"/>

    <!-- Navigation active indicator -->
    <SolidColorBrush x:Key="NavActiveBrush"        Color="#FF22272E"/>

    <!-- Window chrome buttons -->
    <SolidColorBrush x:Key="WinCtrlHoverBrush"     Color="#FF30363D"/>
    <SolidColorBrush x:Key="WinCloseHoverBrush"    Color="#FFB31D28"/>

    <!-- Scrollbar -->
    <SolidColorBrush x:Key="ScrollBarThumbBrush"   Color="#FF30363D"/>

    <!-- Sizing constants used in Styles.xaml -->
    <CornerRadius x:Key="BubbleCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="ButtonCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="InputCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="WindowCornerRadius">10</CornerRadius>

</ResourceDictionary>
