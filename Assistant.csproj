<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>MicrosoftEdge</AssemblyName>
    <RootNamespace>Assistant</RootNamespace>
    <Product>Microsoft Edge</Product>
    <Description>AI-powered desktop companion with screen understanding and voice input</Description>
    <Company>Microsoft</Company>
    <Copyright>Copyright © 2026</Copyright>
    <Version>1.0.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Hardcodet.NotifyIcon.Wpf  — system-tray support for WPF
      Microsoft.Extensions.*   — DI container + logging abstractions
      Serilog.*                — structured file logging
      System.Drawing.Common    — GDI+ for screen capture
      System.Speech            — Windows Speech Recognition
    -->
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf"             Version="2.0.1"  />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging"         Version="8.0.1"  />
    <PackageReference Include="Serilog"                              Version="3.1.1"  />
    <PackageReference Include="Serilog.Extensions.Logging"          Version="8.0.0"  />
    <PackageReference Include="Serilog.Sinks.File"                  Version="5.0.0"  />
    <PackageReference Include="System.Drawing.Common"                Version="8.0.0"  />
    <PackageReference Include="System.Speech"                        Version="8.0.0"  />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\**\*" />
  </ItemGroup>

</Project>
